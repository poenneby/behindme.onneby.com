{
  "name": "behindme",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test DATA_DIR=tmp/test-data ADMIN_EMAILS=boss@example.com,boss2@example.com remix test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "nodemailer": "10.1.7",
    "remix": "^3.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "esbuild@0.27.2": true
  }
}
